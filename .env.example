# Креды кабинета Lamoda Seller.
# Получить: личный кабинет продавца Lamoda -> раздел интеграций/API.
# Никогда не коммить заполненный файл — .env в .gitignore.

LAMODA_CLIENT_ID=
LAMODA_CLIENT_SECRET=

# Необязательно: переопределить хост API (по умолчанию public-api-seller.lamoda.ru)
# LAMODA_HOST=public-api-seller.lamoda.ru
